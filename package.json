{
  "name": "brewlite",
  "private": true,
  "description": "BrewLite – đặt cà phê mobile-first/PWA (Next.js, NestJS, PostgreSQL)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @brewlite/shared build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @brewlite/api dev",
    "dev:web": "pnpm --filter @brewlite/web dev"
  }
}
