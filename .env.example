# BrewLite – biến môi trường mẫu. Sao chép thành .env (KHÔNG commit .env).
#   cp .env.example .env               # cho docker compose
#   cp .env.example apps/api/.env      # khi chạy API trực tiếp trên máy (pnpm dev:api)
# Giá trị dưới đây chỉ dùng cho local. Secret production đặt trong Render/Vercel/GitHub Secrets (docs/architecture/deployment-view.md).

# ----- PostgreSQL (docker compose) -----
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_dev
POSTGRES_DB=brewlite
# Cổng PostgreSQL trên máy host; đổi (ví dụ 5433) nếu 5432 đã bị dùng, nhớ sửa cổng trong DATABASE_URL.
POSTGRES_PORT=5432

# ----- API (apps/api) -----
NODE_ENV=development
PORT=4000
# Chạy API trên máy: host là localhost. Trong docker compose, host là "db" (đã cấu hình sẵn trong docker-compose.yml).
DATABASE_URL=postgresql://brewlite:brewlite_dev@localhost:5432/brewlite?schema=public
# Danh sách origin được gọi API, cách nhau bằng dấu phẩy.
CORS_ORIGIN=http://localhost:3000
# true: chạy seed dữ liệu mẫu mỗi lần container API khởi động (seed idempotent).
SEED_ON_START=false

# ----- Web (apps/web) -----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ----- Sprint 2 (chưa dùng ở Sprint 1) -----
